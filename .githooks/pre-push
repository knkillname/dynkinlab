#
# Run the fast local verification sequence before a push.
#
# Enable it once per clone with:
#   git config core.hooksPath .githooks

set -eu

if ! repo_root=$(git rev-parse --show-toplevel 2>/dev/null); then
    printf 'pre-push: not inside a Git work tree.\n' >&2
    exit 1
fi

cd "$repo_root"

if ! command -v hatch >/dev/null 2>&1; then
    printf 'pre-push: hatch is required. Install it with: uv tool install hatch\n' >&2
    exit 1
fi

printf '\npre-push: running local verification...\n'
if ! hatch run verify; then
    printf '\npre-push: verification failed; push aborted.\n' >&2
    exit 1
fi
